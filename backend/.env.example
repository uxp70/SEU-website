# Copy to .env (never commit .env)
# SHA-256 hex of the site password (generate: node -e "console.log(require('crypto').createHash('sha256').update('YOUR-PASSWORD','utf8').digest('hex'))")
SEU_PASSWORD_HASH=put-sha256-hex-here
# Long random string for signing sessions
SEU_SECRET=change-this-to-a-long-random-string
PORT=3000
# Comma-separated allowed frontend origins, e.g. https://seuhq.dpdns.org
ALLOWED_ORIGINS=http://seuhq.dpdns.org,https://seuhq.dpdns.org
# Site content as JSON (see CONTENT.example.json for shape). Keeps all
# visible text out of the public repo.
SEU_CONTENT_JSON=
# Optional: GitHub token to raise the file-listing rate limit
SEU_GITHUB_TOKEN=
